# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# MongoDB Connection String (Local or MongoDB Atlas Cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/frnd_app

# JWT Secret Key for Session Authentication (Use a cryptographically random string in production)
JWT_SECRET=replace_with_a_long_random_secret_key_at_least_32_chars

# Allowed CORS Origins (Comma-separated for multiple origins, or * for development)
CORS_ORIGIN=*

# OTP Service & SMS Provider Configuration
# MSG91 (Default SMS provider for India - https://msg91.com)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_dlt_approved_template_id
OTP_HASH_SECRET=replace_with_a_secret_salt_for_hashing_otps
